# ==========================================
# .gitignore — Curso Kubernetes Administración (30h)
# ==========================================

# Dependencias y entornos de ejecución
node_modules/
.npm/

# Entornos virtuales de Python y empaquetado
.venv/
venv/
env/
ENV/

# Caché de Python y binarios compilados
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/

# Registros y logs de npm / yarn / pnpm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# Archivos temporales de compilación documental y PDF
dist/*_temp.html
dist/*_raw.pdf
dist/slides_meta.json
*.tmp
*.temp

# Archivos de bloqueo y temporales de Office / LibreOffice
.~lock.*#
~$*
.~lock.*

# Renders temporales, capturas y pruebas de QA visual
qa/
temp/
tmp/

# Variables de entorno y secretos
.env
.env.*
!.env.example

# Archivos del sistema operativo y editores / IDEs
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo
*~
